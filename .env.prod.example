# TALOS production (kanda-server). Copy to .env.prod and fill in.
# Never commit .env.prod. HashiCorp Vault can hold these later; a file on the
# host is enough for the first deploy (same as Keycloak/Outline today).

TALOS_VERSION=1.2.0
# Official image (one Hub repo; tags: {VERSION}-web|storage|bunker)
TALOS_IMAGE=kandacloud/talos

# Host paths on kanda-server (override if you clone elsewhere)
TALOS_DATA=/docker/volumes-data/talos
TALOS_CONFIG=/docker/volumes-config/talos

# Inter-service HMAC. Generate once:
#   openssl rand -hex 32
SHARED_SECRET=change-me-openssl-rand-hex-32

# Shown as GPG identity hint; each user still has their own vault passphrase
GPG_ID=talos@kanda.cloud

MULTIUSER=true
TALOS_CUSTODY_MODE=strict

# Keycloak NDK on kanda (same process as Outline, NEW realm "talos" — not start-dev)
OIDC_ISSUER=https://dev.kanda.cloud:8483/realms/talos
OIDC_ISSUER_INTERNAL=https://dev.kanda.cloud:8483/realms/talos
OIDC_CLIENT_ID=talos-web
OIDC_CLIENT_SECRET=change-me-keycloak-client-secret
OIDC_REDIRECT_URI=https://talos.kanda.cloud/api/auth/oidc/callback
