# Talos local development environment
# Vault passphrase for local seed / fixtures (also used as per-user vault key under MULTIUSER)
GPG_ID=dev@talos.local
SHARED_SECRET=talos_dev_secret
TALOS_MASTER_KEY=DevMasterKey-ChangeMe!
TALOS_URL=http://localhost:3000
DEBUG=true

# Multi-user / Keycloak
MULTIUSER=true
TALOS_CUSTODY_MODE=strict
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://localhost:8080/realms/talos
OIDC_ISSUER_INTERNAL=http://keycloak:8080/realms/talos
OIDC_CLIENT_ID=talos-web
OIDC_CLIENT_SECRET=talos-web-dev-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# Dev Keycloak user: dev / devpass (roles: talos-user, talos-admin)
# KEYCLOAK_USER=dev
# KEYCLOAK_PASSWORD=devpass
# Operator KEK for convenience mode (only used when TALOS_CUSTODY_MODE=convenience)
# TALOS_OPERATOR_KEK=DevOperatorKek-ChangeMe!
